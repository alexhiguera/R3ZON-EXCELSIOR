model service_versions {
  id              String         @id @default(dbgenerated("uuidv7()")) @db.Uuid
  service_id      String         @db.Uuid
  version         Int            @default(0)
  price_cents     BigInt
  vat_rate        Decimal        @default(21.00) @db.Decimal(5, 2)
  payment_plans   payment_plan[] @default([pago_unico])
  deposit_percent Int?           @db.SmallInt
  includes        String[]       @default([])
  created_by      String?        @db.Uuid
  created_at      DateTime       @default(now()) @db.Timestamptz(6)
  engagements     engagements[]
  services        services       @relation(fields: [service_id], references: [id], onUpdate: NoAction)

  @@unique([service_id, version], map: "service_versions_unique")
  @@index([created_by])
}

