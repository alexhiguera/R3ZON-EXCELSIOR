// ─────────────────────────────────────────────────────────────────────────────
// GENERADO con `npm run db:pull`. No se edita a mano.
//
// Sale de introspeccionar la base LOCAL, que es el resultado de aplicar
// supabase/migrations/: esa es la fuente de verdad del esquema, no este fichero.
// Tocar esto no cambia la base, y CI (`npm run db:drift`) falla si deja de
// coincidir con lo que producen las migraciones.
//
// Solo el esquema `public`. Las FK hacia `auth.users` existen en la base pero
// no aquí: `auth` es de Supabase y queda fuera a propósito.
//
// Lo que Prisma no representa y SÍ existe en la base: la RLS y sus policies, las
// funciones, los triggers, los CHECK y los grants. Guía: docs/DATABASE.md
// ─────────────────────────────────────────────────────────────────────────────

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model audit_log {
  id              String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  created_at      DateTime @default(now()) @db.Timestamptz(6)
  actor_id        String?  @db.Uuid
  organization_id String?  @db.Uuid
  action          String
  details         Json     @default("{}")

  @@index([actor_id])
  @@index([created_at])
  @@index([organization_id, created_at(sort: Desc)], map: "audit_log_organization_id_idx")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model engagement_status_history {
  id            String             @id @default(dbgenerated("uuidv7()")) @db.Uuid
  engagement_id String             @db.Uuid
  from_status   engagement_status?
  to_status     engagement_status
  changed_by    String?            @db.Uuid
  changed_at    DateTime           @default(now()) @db.Timestamptz(6)
  reason        String?
  engagements   engagements        @relation(fields: [engagement_id], references: [id], onUpdate: NoAction)

  @@index([engagement_id, changed_at], map: "engagement_status_history_engagement_idx")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model engagements {
  id                        String                      @id @default(dbgenerated("uuidv7()")) @db.Uuid
  organization_id           String                      @db.Uuid
  service_version_id        String                      @db.Uuid
  invitation_id             String?                     @db.Uuid
  status                    engagement_status           @default(borrador)
  price_cents               BigInt
  conditions                String?
  created_by                String?                     @db.Uuid
  created_at                DateTime                    @default(now()) @db.Timestamptz(6)
  updated_at                DateTime                    @default(now()) @db.Timestamptz(6)
  status_changed_at         DateTime                    @default(now()) @db.Timestamptz(6)
  engagement_status_history engagement_status_history[]
  invitations               invitations?                @relation(fields: [invitation_id], references: [id], onUpdate: NoAction)
  organizations             organizations               @relation(fields: [organization_id], references: [id], onUpdate: NoAction)
  service_versions          service_versions            @relation(fields: [service_version_id], references: [id], onUpdate: NoAction)

  @@index([created_by])
  @@index([invitation_id])
  @@index([organization_id, created_at(sort: Desc)], map: "engagements_organization_id_idx")
  @@index([service_version_id])
  @@index([status])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model invitations {
  id              String        @id @default(dbgenerated("uuidv7()")) @db.Uuid
  organization_id String        @db.Uuid
  email           String
  role            org_role      @default(owner)
  token_hash      Bytes         @unique
  expires_at      DateTime      @db.Timestamptz(6)
  created_by      String?       @db.Uuid
  created_at      DateTime      @default(now()) @db.Timestamptz(6)
  accepted_at     DateTime?     @db.Timestamptz(6)
  accepted_by     String?       @db.Uuid
  revoked_at      DateTime?     @db.Timestamptz(6)
  engagements     engagements[]
  organizations   organizations @relation(fields: [organization_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([organization_id, email], map: "invitations_one_open_per_org_email", where: raw("((accepted_at IS NULL) AND (revoked_at IS NULL))"))
  @@index([accepted_by])
  @@index([created_by])
  @@index([organization_id])
  @@index([email], map: "invitations_pending_email_idx", where: raw("((accepted_at IS NULL) AND (revoked_at IS NULL))"))
}

