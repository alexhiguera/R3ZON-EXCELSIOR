{
  "name": "r3zon-template",
  "version": "0.1.0",
  "private": true,
  "description": "Plantilla base de proyectos SaaS de R3ZON",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:db": "vitest run tests/db",
    "pretest:e2e": "npm run db:reset && npm run seed:e2e",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:status": "supabase status",
    "db:validate": "prisma validate",
    "db:pull": "node scripts/prisma-db.mjs pull",
    "db:drift": "node scripts/prisma-db.mjs drift",
    "db:studio": "node scripts/prisma-db.mjs studio",
    "db:types": "node scripts/db-types.mjs",
    "db:types:check": "node scripts/db-types.mjs --comprobar",
    "seed:dev": "node scripts/seed-dev.mjs",
    "seed:e2e": "node scripts/seed-e2e.mjs",
    "docs:validar": "node scripts/validar-public-docs.mjs",
    "docs:enlaces": "node scripts/verificar-enlaces-docs.mjs",
    "deps:overrides": "node scripts/verificar-overrides.mjs",
    "dev:setup": "bash scripts/dev-setup.sh"
  },
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "browserslist": [
    "chrome >= 111",
    "edge >= 111",
    "firefox >= 111",
    "safari >= 16.4",
    "not dead"
  ],
  "dependencies": {
    "@sentry/nextjs": "^10.75.2",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.0",
    "@vercel/speed-insights": "^2.0.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.47.0",
    "next": "^16.3.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/jest-axe": "^3.5.9",
    "@types/node": "^24.13.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.1",
    "jest-axe": "^11.0.0",
    "jsdom": "^30.1.1",
    "pg": "^8.23.0",
    "prisma": "^7.10.0",
    "supabase": "^2.117.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1",
    "yaml": "^2.9.1"
  },
  "overrides": {
    "mysql2": "^3.24.4",
    "deepmerge-ts": "^8.0.2"
  },
  "allowScripts": {
    "prisma@7.10.0": true,
    "@prisma/engines@7.10.0": true,
    "@sentry/cli@2.58.6": true
  }
}
