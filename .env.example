# =============================================================================
# Variables de entorno — copia este fichero a .env.local
# =============================================================================
# `npm run dev:setup` rellena las de Supabase automáticamente a partir del stack
# local. Nunca se versiona un .env con valores reales (.gitignore lo impide).
#
# Regla: lo que lleva NEXT_PUBLIC_ acaba en el navegador. Un secreto NUNCA
# lleva ese prefijo.
# =============================================================================

# ── Supabase ─────────────────────────────────────────────────────────────────
# Local: las da `npx supabase status`. Producción: panel de Supabase → API.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55421
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ── App ──────────────────────────────────────────────────────────────────────
# URL pública. En producción, si no se define, se usa el dominio de
# src/config/project.ts.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Sentry (opcional) ────────────────────────────────────────────────────────
# Sin DSN, Sentry no arranca. En local se deja vacío a propósito.
NEXT_PUBLIC_SENTRY_DSN=
# Solo para subir source maps en el build de Vercel. Sin token, el build no
# usa el plugin de Sentry.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# ── Desarrollo local ─────────────────────────────────────────────────────────
# Usuario que crea `npm run seed:dev` (solo en el Supabase local).
DEV_EMAIL=dev@example.test
DEV_PASSWORD=dev-password-local-only

# Nivel del logger: debug | info | warn | error (por defecto: info en prod).
# LOG_LEVEL=debug

# ── Login con Google (opcional) ──────────────────────────────────────────────
# «true» muestra «Continuar con Google» en el login y en las invitaciones. Solo
# si el proveedor está activo en Supabase (docs/DEVELOPMENT.md → Google en local).
# Pública: no es un secreto.
NEXT_PUBLIC_AUTH_GOOGLE=
