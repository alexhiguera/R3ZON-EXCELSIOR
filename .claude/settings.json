{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "ask": ["Bash(git commit:*)", "Bash(git push:*)", "Bash(git tag:*)"],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.*.local)",
      "Read(./.env.production)",
      "Bash(cat .env:*)",
      "Bash(head .env:*)",
      "Bash(tail .env:*)",
      "Bash(less .env:*)",
      "Bash(more .env:*)",
      "Bash(bat .env:*)",
      "Bash(npx prisma db push:*)",
      "Bash(npx prisma migrate:*)",
      "Bash(prisma db push:*)",
      "Bash(prisma migrate:*)"
    ]
  }
}
